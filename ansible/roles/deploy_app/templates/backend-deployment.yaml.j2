apiVersion: apps/v1
kind: Deployment
metadata:
  name: perfume-backend
  labels:
    app: perfume-backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: perfume-backend
  template:
    metadata:
      labels:
        app: perfume-backend
    spec:
      containers:
        - name: perfume-backend
          image: ghcr.io/bahaa202/perfume-ai-shop-backend:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 5000
          env:
            - name: DATABASE_URL
              value: "postgresql://perfume_admin:devlocal123@{{ ansible_default_ipv4.address }}:5432/perfume_shop"
          readinessProbe:
            httpGet:
              path: /health
              port: 5000
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: perfume-backend-service
spec:
  type: NodePort
  selector:
    app: perfume-backend
  ports:
    - port: 5000
      targetPort: 5000
      nodePort: 30500
